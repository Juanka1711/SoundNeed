<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soundneed_widget_background">

    <!-- Fondo dinámico generado desde la portada -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="7dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- PORTADA -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:background="@drawable/soundneed_widget_artwork_rounded"
            android:clipToOutline="true"
            android:contentDescription="Portada de la canción"
            android:src="@drawable/soundneed_widget_placeholder" />

        <!-- INFORMACIÓN -->
        <LinearLayout
            android:id="@+id/widget_information"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <!-- ANTERIOR -->
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Canción anterior"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/soundneed_widget_previous" />

        <!-- PLAY / PAUSE + ANILLO -->
        <FrameLayout
            android:id="@+id/widget_play_container"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center">

            <!-- Anillo de progreso -->
            <ImageView
                android:id="@+id/widget_progress_ring"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

            <!-- Botón -->
            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:contentDescription="Reproducir o pausar"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/soundneed_widget_play" />

        </FrameLayout>

        <!-- SIGUIENTE -->
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Canción siguiente"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/soundneed_widget_next" />

    </LinearLayout>

</FrameLayout>
